#   │       │   ├── node/      → node
#   │       │   ├── php/       → phpc
#   │       │   ├── python/    → (unassigned)
#   │       │   └── ruby/      → ruby
#   │       ├── ebpf/          → ebpf
#   │       └── infrastructure/
#   │           ├── awslinux.yml / centos_rhel.yml / darwin.yml / debian.yml
#   │           │   / suse.yml / ubuntu.yml / windows.yml  → ohai (infra agent install)
#   │           ├── agent-control/ → ac
#   │           ├── alerts/    → virtuoso
#   │           ├── cloud/     → virtuoso
#   │           ├── logs/      → logint
#   │           ├── kubernetes.yml → k8s-agents
#   │           ├── nrdot/
#   │           │   ├── mssql-otel/ / mysql-otel/ / oracle-otel/ / postgresql-otel/  → dbi
#   │           │   └── elasticsearch-otel/ / haproxy/ / ibm-mq/ / kafka/ / nginx/
#   │           │       / nginx-plus/ / rabbitmq/ / redis/                           → ohai
#   │           └── ohi/
#   │               ├── cassandra/ / couchbase/ / mongodb/ / mysql/ / oracle/
#   │               │   / postgres/ / sql/                                    → dbi
#   │               └── apache/ / consul/ / elasticsearch/ / haproxy/ / kafka/
#   │                   / memcached/ / nagios/ / nginx/ / rabbitmq/ / redis/
#   │                   / varnish/                                             → ohai
#   └── test/
#       ├── definitions*/          (US / EU / JP — mirrors recipes/ ownership)
#       │   ├── apm/
#       │   │   ├── dotNet/        → dotnet  (all 3 regions)
#       │   │   ├── java/          → java    (all 3 regions)
#       │   │   ├── node/          → node    (all 3 regions)
#       │   │   └── php-agent/     → phpc    (EU/JP only; US php is loose JSON)
#       │   ├── agent-control/     → ac      (all 3 regions)
#       │   ├── alerts/            → virtuoso (US only)
#       │   ├── ebpf/              → ebpf    (US only)
#       │   ├── infra-agent/       → ohai    (all 3 regions)
#       │   ├── logging/           → logint  (all 3 regions)
#       │   ├── nrdot/             → ohai (US only)
#       │   │   ├── mssql-otel/ / mysql-otel/ / postgresql-otel/  → dbi
#       │   │   └── elasticsearch/ / haproxy/ / ibm-mq/ / kafka/ / nginx/ / rabbitmq/ / redis/  → ohai
#       │   ├── ohi/
#       │   │   ├── linux/         → per-file globs:
#       │   │   │   ├── couchbase-* / mongodb-* / mysql-* / postgres-*  → dbi
#       │   │   │   └── apache-* / consul-* / docker-* / elasticsearch-* / haproxy-* / k8-* / memcached-* / nagios-* / nginx-* / rabbitmq-* / redis-* / varnish-*  → ohai
#       │   │   └── windows/       → dbi (ms-sql only)
#       │   └── smoke/             → virtuoso (all 3 regions)
#       ├── deploy/
#       │   ├── assertions/        → virtuoso
#       │   ├── linux/
#       │   │   ├── shell/ go/ docker/ newrelic-cli/ → virtuoso
#       │   │   ├── dotNet/        → dotnet
#       │   │   ├── java/ jboss/ jetty/ jmx-*/ tomcat/ → java
#       │   │   ├── nodejs/        → node
#       │   │   ├── php/           → phpc
#       │   │   ├── python/        → python
