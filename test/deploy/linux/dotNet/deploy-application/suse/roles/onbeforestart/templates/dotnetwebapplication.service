[Unit]
Description={{ service_id }} ASP.NET Core Web app

[Service]
WorkingDirectory=/var/www/{{ service_id }}/
ExecStart={{ startup_command }} --urls=http://0.0.0.0:{{ service_port }}/
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier={{ service_id }}
User=dotnetapp
Environment=ASPNETCORE_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target
