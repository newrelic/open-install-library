{
    "global_tags": {
        "owning_team": "virtuoso",
        "Environment": "development",
        "Department": "product",
        "Product": "virtuoso"
    },

    "resources": [{
        "id": "suse157",
        "provider": "aws",
        "type": "ec2",
        "size": "t3.micro",
        "ami_name": "suse-sles-15-sp7-v*-hvm-ssd-x86_64",
        "user_name": "ec2-user"
    }],

    "services": [{
        "id": "aspnetcore",
        "destinations": ["suse157"],
        "source_repository": "https://github.com/newrelic/open-install-library.git",
        "deploy_script_path": "test/deploy/linux/dotNet/install/suse/roles",
        "port": 9999
      },
      {
        "id": "dotnet1",
        "destinations": ["suse157"],
        "source_repository": "https://github.com/newrelic/open-install-library.git",
        "deploy_script_path": "test/deploy/linux/dotNet/deploy-application/suse/roles",
        "port": 8080,
        "params": {
            "is_selfcontained": "true",
            "use_executable": "true"
        }
      },
      {
        "id": "dotnet2",
        "destinations": ["suse157"],
        "source_repository": "https://github.com/newrelic/open-install-library.git",
        "deploy_script_path": "test/deploy/linux/dotNet/deploy-application/suse/roles",
        "port": 8081
      }],

  "instrumentations": {
    "resources": [
      {
        "id": "cli1",
        "resource_ids": ["suse157"],
        "provider": "newrelic",
        "source_repository": "https://github.com/newrelic/open-install-library.git",
        "deploy_script_path": "test/deploy/linux/newrelic-cli/install-recipe/roles",
        "params": {
          "recipe_content_url": "https://raw.githubusercontent.com/newrelic/open-install-library/main/recipes/newrelic/infrastructure/suse.yml,https://raw.githubusercontent.com/newrelic/open-install-library/main/recipes/newrelic/apm/dotNet/linux-systemd.yml",
          "validate_output": ".NET Agent\\s+\\(installed\\)"
        }
      }
    ]
  }
}
