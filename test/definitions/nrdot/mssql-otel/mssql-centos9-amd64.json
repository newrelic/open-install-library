{
  "global_tags": {
    "owning_team": "Database Integration",
    "Environment": "development",
    "Department": "product",
    "Product": "Database Integration"
  },
  "resources": [
    {
      "id": "host1",
      "provider": "aws",
      "type": "ec2",
      "size": "t3.medium",
      "ami_name": "CentOS Stream 9 x86_64*",
      "user_name": "ec2-user"
    }
  ],
  "instrumentations": {
    "resources": [
      {
        "id": "mssqlotelcentos9",
        "resource_ids": ["host1"],
        "source_repository": "https://github.com/newrelic/open-install-library.git",
        "deploy_script_path": "test/deploy/linux/newrelic-cli/install-recipe/roles",
        "params": {
          "recipe_content_url": "https://raw.githubusercontent.com/newrelic/open-install-library/main/recipes/newrelic/infrastructure/nrdot/mssql-otel/rhel.yml",
          "recipe_targeted": "nrdot-collector-mssql",
          "validate_output": "NRDOT MSSQL \\(RHEL/CentOS\\)\\s+\\(installed\\)",
          "env_var": "NEW_RELIC_CLI_SKIP_CORE=1 NR_CLI_MSSQL_SA_PASSWORD=[credential:secrets:nrMssqlSaPassword] NR_CLI_MSSQL_SERVER=localhost NR_CLI_MSSQL_PORT=1433 NR_CLI_MSSQL_CONFIG_PRESET=1"
        },
        "provider": "newrelic"
      }
    ]
  }
}
