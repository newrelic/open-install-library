{
  "global_tags": {
    "owning_team": "database-integrations",
    "Environment": "development",
    "Department": "product",
    "Product": "database-integrations"
  },
  "resources": [
    {
      "id": "host1",
      "provider": "aws",
      "type": "ec2",
      "size": "t3.medium",
      "ami_name": "CentOS Stream 9 x86_64*",
      "user_name": "ec2-user"
    }
  ],
  "instrumentations": {
    "resources": [
      {
        "id": "oracleotelcentos",
        "resource_ids": ["host1"],
        "source_repository": "https://github.com/newrelic/open-install-library.git",
        "deploy_script_path": "test/deploy/linux/newrelic-cli/install-recipe/roles",
        "params": {
          "recipe_content_url": "https://raw.githubusercontent.com/newrelic/open-install-library/main/recipes/newrelic/infrastructure/nrdot/oracle-otel/rhel.yml",
          "recipe_targeted": "nrdot-collector-oracle",
          "validate_output": "NRDOT Oracle Database \\(RHEL/CentOS/OEL\\)\\s+\\(installed\\)",
          "env_var": "NEW_RELIC_CLI_SKIP_CORE=1 NR_CLI_ORACLE_CONFIG_PRESET=1 NR_CLI_ORACLE_CONTAINER_TYPE=1 NR_CLI_ORACLE_HOST=localhost NR_CLI_ORACLE_PORT=1521 NR_CLI_ORACLE_SYS_PASSWORD=[credential:secrets:nrOracleSysPassword] NR_CLI_ORACLE_SERVICE_NAME=[credential:secrets:nrOracleCdbServiceName]"
        },
        "provider": "newrelic"
      }
    ]
  }
}
